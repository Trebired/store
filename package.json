{
  "bugs": {
    "url": "https://github.com/Trebired/store/issues"
  },
  "dependencies": {
    "@package/logger-adapter": "npm:@trebired/logger-adapter@^0.2.3",
    "@package/result": "npm:@trebired/result@^1.0.1",
    "pg": "^8.22.0"
  },
  "description": "Reusable generic entity store for Bun and Node.js with typed entity registries, SQLite, scoped JSONB storage, modes, request loaders, cache invalidation, and sub-entity reads.",
  "devDependencies": {
    "@trebired/code-discipline": "^4.7.1",
    "@types/bun": "1.3.4",
    "@types/node": "24.10.1",
    "@types/pg": "^8.20.0",
    "typescript": "6.0.2"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=18"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "homepage": "https://github.com/Trebired/store#readme",
  "keywords": [
    "store",
    "entity-store",
    "jsonb",
    "sqlite",
    "postgres",
    "cache",
    "node",
    "bun"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "name": "@trebired/store",
  "packageManager": "bun@1.3.12",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Trebired/store.git"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node ./scripts/prepare-dist.mjs prepare-dist",
    "postpack": "node ./scripts/prepare-dist.mjs postpack",
    "prepack": "bun run build && node ./scripts/prepare-dist.mjs prepack",
    "prepublishOnly": "bun run typecheck && bun test && bun run verify:pack",
    "test": "bun -e \"console.log(\\\"No tests configured.\\\")\"",
    "typecheck": "tsc --noEmit",
    "verify:pack": "node ./scripts/verify-pack.mjs"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "1.0.3"
}
