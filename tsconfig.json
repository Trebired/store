{
  "compilerOptions": {
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "checkJs": false,
    "esModuleInterop": true,
    "lib": [
      "ES2020"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "target": "ES2020",
    "types": [
      "bun",
      "node"
    ]
  },
  "exclude": [
    "node_modules",
    "dist",
    ".tmp"
  ],
  "extends": "./.code-discipline/generated/tsconfig.paths.json",
  "include": [
    "src/**/*.ts",
    "examples/**/*.ts",
    "tb.code-discipline.ts"
  ]
}
